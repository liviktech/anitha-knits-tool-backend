generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

enum ProductionStage {
  EXTRUDER

  LOOMS

  FABRIC_CHECKING
}

enum ProductionStatus {
  DRAFT

  SUBMITTED

  PENDING_APPROVAL

  APPROVED

  REJECTED
}

enum ApprovalMode {
  AUTO_APPROVAL

  MANAGER_APPROVAL
}

enum ProductionRecordType {
  NORMAL

  ADJUSTMENT

  REVERSAL
}

enum ApprovalEntityType {
  PRODUCTION_RECORD

  WASTAGE_RECORD
}

enum InventoryType {
  RAW_MATERIAL

  CHEMICAL

  YARN

  FABRIC
}

model ProductionSetting {
  id String @id @default(uuid()) @db.Uuid

  singleton Boolean @unique @default(true)

  approvalMode ApprovalMode @default(MANAGER_APPROVAL) @map("approval_mode")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("production_settings")
}

model Brand {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("brands")
}

model Chemical {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("chemicals")
}

model Color {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(50)

  productionRecords ProductionRecord[]

  wastageRecords WastageRecord[]

  loadSents LoadSent[]

  consumptionStandard ColorConsumptionStandard?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("colors")
}

model Size {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(30)

  productionRecords ProductionRecord[]

  loadSents LoadSent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("sizes")
}

model ColorConsumptionStandard {
  id String @id @default(uuid()) @db.Uuid

  colorId String @unique @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  gramsPerBasis Decimal @map("grams_per_basis") @db.Decimal(10, 3)

  basisWeightKg Decimal @default(25) @map("basis_weight_kg") @db.Decimal(10, 3)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@map("color_consumption_standards")
}

model ProductionRecord {
  id String @id @default(uuid()) @db.Uuid

  stage ProductionStage

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid

  size Size @relation(fields: [sizeId], references: [id])

  recordType ProductionRecordType @default(NORMAL) @map("record_type")

  reversesRecordId String? @map("reverses_record_id") @db.Uuid

  reversesRecord ProductionRecord? @relation("ProductionCorrection", fields: [reversesRecordId], references: [id])

  corrections ProductionRecord[] @relation("ProductionCorrection")

  status ProductionStatus @default(DRAFT)

  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)

  remarks String? @db.VarChar(500)

  extruder ExtruderDetail?

  loom LoomDetail?

  fabricCheck FabricCheckDetail?

  wastages WastageRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([productionDate])
  @@index([stage, productionDate])
  @@index([colorId, sizeId])
  @@index([status])
  @@index([reversesRecordId])
  @@map("production_records")
}

model ExtruderDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  brandId String @map("brand_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id])

  rawMaterialKg Decimal @map("raw_material_kg") @db.Decimal(12, 3)

  chemicalId String @map("chemical_id") @db.Uuid

  chemical Chemical @relation(fields: [chemicalId], references: [id])

  chemicalKg Decimal @map("chemical_kg") @db.Decimal(12, 3)

  colorConsumedKg Decimal @map("color_consumed_kg") @db.Decimal(12, 3)

  yarnOutputKg Decimal @map("yarn_output_kg") @db.Decimal(12, 3)

  isRecipeOverridden Boolean @default(false) @map("is_recipe_overridden")

  overrideReason String? @map("override_reason") @db.VarChar(500)

  @@index([brandId])
  @@index([chemicalId])
  @@map("extruder_details")
}

model LoomDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  yarnInputKg Decimal @map("yarn_input_kg") @db.Decimal(12, 3)

  fabricOutputKg Decimal @map("fabric_output_kg") @db.Decimal(12, 3)

  @@map("loom_details")
}

model FabricCheckDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  fabricInputKg Decimal @map("fabric_input_kg") @db.Decimal(12, 3)

  pieceCount Int @map("piece_count")

  firstGradeKg Decimal @map("first_grade_kg") @db.Decimal(12, 3)

  secondGradeKg Decimal @map("second_grade_kg") @db.Decimal(12, 3)

  @@map("fabric_check_details")
}

model WastageType {
  id String @id @default(uuid()) @db.Uuid

  stage ProductionStage

  code String @db.VarChar(50)

  name String @db.VarChar(100)

  isColorTracked Boolean @default(false) @map("is_color_tracked")

  isActive Boolean @default(true) @map("is_active")

  wastageRecords WastageRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([stage, code])
  @@index([stage, isActive])
  @@map("wastage_types")
}

model WastageRecord {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id])

  wastageTypeId String @map("wastage_type_id") @db.Uuid

  wastageType WastageType @relation(fields: [wastageTypeId], references: [id])

  colorId String? @map("color_id") @db.Uuid

  color Color? @relation(fields: [colorId], references: [id])

  quantityKg Decimal @map("quantity_kg") @db.Decimal(12, 3)

  reason String? @db.VarChar(500)

  status ProductionStatus @default(DRAFT)

  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([productionRecordId])
  @@index([wastageTypeId])
  @@index([colorId])
  @@index([status])
  @@map("wastage_records")
}

model ApprovalEvent {
  id String @id @default(uuid()) @db.Uuid

  entityType ApprovalEntityType @map("entity_type")

  entityId String @map("entity_id") @db.Uuid

  fromStatus ProductionStatus @map("from_status")

  toStatus ProductionStatus @map("to_status")

  reason String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  @@index([entityType, entityId, createdAt])
  @@index([toStatus, createdAt])
  @@map("approval_events")
}

model Inventory {
  id        String        @id @default(uuid()) @db.Uuid
  date      DateTime      @default(now())
  type      InventoryType
  name      String        @db.VarChar(150)
  weightKg  Decimal       @map("weight_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([date])
  @@index([type])
  @@index([name])
  @@map("inventory")
}

model LoadSent {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @default(now())

  colorId String @map("color_id") @db.Uuid
  color   Color  @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid
  size   Size   @relation(fields: [sizeId], references: [id])

  pieceCount Int     @map("piece_count")
  weightKg  Decimal  @map("weight_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([date])
  @@index([colorId])
  @@index([sizeId])
  @@map("load_sent")
}