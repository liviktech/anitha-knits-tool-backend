generator client {
  provider = "prisma-client-js"

  binaryTargets = ["native", "rhel-openssl-3.0.x"]

  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN

  MANAGER

  SUPERVISOR

  EMPLOYEE
}

enum PlatformAdminRole {
  SUPER_ADMIN
}

enum ProductionStage {
  EXTRUDER

  LOOMS

  FABRIC_CHECKING

  DELIVERY
}

enum ProductionRecordType {
  NORMAL

  ADJUSTMENT

  REVERSAL
}

enum ProductionType {
  PRODUCTION
  SAMPLE
}

enum InventoryType {
  HDPE

  CHEMICAL

  COLOR
}

enum Gender {
  MALE

  FEMALE

  OTHER
}

model PlatformAdmin {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  mobile String @unique @db.VarChar(15)

  passwordHash String @map("password_hash") @db.VarChar(255)

  role PlatformAdminRole @default(SUPER_ADMIN)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

model Company {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  address String? @db.VarChar(500)

  gst String? @unique @db.VarChar(20)

  adminMobile String @unique @map("admin_mobile") @db.VarChar(15)

  adminPasswordHash String @map("admin_password_hash") @db.VarChar(255)

  companyCode String @unique @map("company_code") @db.VarChar(50)

  // Next sequence number to assign as a user's customUserId suffix (companyCode + zero-padded seq).
  // Atomically incremented, never decremented — a stable counter, not a row count, so it can't
  // reissue a number after a user/employeeDetails row is later deleted.
  employeeSeq Int @default(1) @map("employee_seq")

  isActive Boolean @default(true) @map("is_active")

  users User[]

  brands Brand[]

  chemicals Chemical[]

  colors Color[]

  sizes Size[]

  colorConsumptionStandards ColorConsumptionStandard[]

  wastageTypes WastageType[]

  productionRecords ProductionRecord[]

  wastageRecords WastageRecord[]

  inventories Inventory[]

  loadSents LoadSent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([isActive])
  @@map("companies")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String? @db.VarChar(150)

  mobile String @db.VarChar(15)

  passwordHash String @map("password_hash") @db.VarChar(255)

  role UserRole @default(EMPLOYEE)

  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  employeeDetails EmployeeDetails?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, mobile])
  @@index([companyId])
  @@index([companyId, role])
  @@index([companyId, isActive])
  @@map("users")
}

model EmployeeDetails {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Server-generated only (companyCode + zero-padded sequence, e.g. "AK001" + "001") — never accepted from a client.
  customUserId String @unique @map("custom_user_id") @db.VarChar(60)

  name String? @db.VarChar(150)

  designation String? @db.VarChar(100)

  address String? @db.VarChar(500)

  gender Gender?

  salary Decimal? @db.Decimal(12, 2)

  aadhaarDocumentUrl String? @map("aadhaar_document_url") @db.VarChar(500)

  documentName String? @map("document_name") @db.VarChar(255)

  aadhaarDocumentUploadedAt DateTime? @map("aadhaar_document_uploaded_at") @db.Timestamptz(6)

  joiningDate DateTime? @map("joining_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("employee_details")
}


model Brand {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  inventories Inventory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model Chemical {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  inventories Inventory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("chemicals")
}

model Color {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(50)

  productionRecords ProductionRecord[]

  wastageRecords WastageRecord[]

  loadSents LoadSent[]

  inventories Inventory[]

  koraBalances KoraBalance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("colors")
}

model Size {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(30)

  productionRecords ProductionRecord[]

  koraBalances KoraBalance[]

  loadSents LoadSent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("sizes")
}

model ColorConsumptionStandard {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  basisWeightKg Decimal @default(25) @map("basis_weight_kg") @db.Decimal(10, 3)

  hdpematerialbag Int @default(1) @map("hdpe_material_bag")

  whiteKgBasis Decimal @map("white_kg_basis") @db.Decimal(10, 3)
  blueKgBasis  Decimal @map("blue_kg_basis") @db.Decimal(10, 3)
  greenKgBasis Decimal @map("green_kg_basis") @db.Decimal(10, 3)

  chemicalWeight Decimal?  @map("chemical_weight_kg") @db.Decimal(12, 3)
  date           DateTime? @map("date") @db.Date

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@map("color_consumption_standards")
}

model ProductionRecord {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type ProductionType @default(PRODUCTION)

  stage ProductionStage

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid

  size Size @relation(fields: [sizeId], references: [id])

  recordType ProductionRecordType @default(NORMAL) @map("record_type")

  reversesRecordId String? @map("reverses_record_id") @db.Uuid

  reversesRecord ProductionRecord? @relation("ProductionCorrection", fields: [reversesRecordId], references: [id])

  corrections ProductionRecord[] @relation("ProductionCorrection")

  remarks String? @db.VarChar(500)

  extruder ExtruderDetail?

  loom LoomDetail?

  fabricCheck FabricCheckDetail?
  wastages    WastageRecord[]
  loadSent    LoadSent?
  koraEntries KoraLedgerEntry?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([companyId, productionDate])
  @@index([companyId, stage, productionDate])
  @@index([colorId, sizeId])
  @@index([reversesRecordId])
  @@map("production_records")
}

model ExtruderDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  brandId String @map("brand_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id])

  rawMaterialKg Decimal @map("raw_material_kg") @db.Decimal(12, 3)

  chemicalId String @map("chemical_id") @db.Uuid

  chemical Chemical @relation(fields: [chemicalId], references: [id])

  chemicalKg Decimal @map("chemical_kg") @db.Decimal(12, 3)

  colorConsumedKg Decimal @map("color_consumed_kg") @db.Decimal(12, 3)

  yarnOutputKg Decimal @map("yarn_output_kg") @db.Decimal(12, 3)

  isRecipeOverridden Boolean @default(false) @map("is_recipe_overridden")

  overrideReason String? @map("override_reason") @db.VarChar(500)

  bagCount      Int?     @map("bag_count")
  bagWeightKg   Decimal? @map("bag_weight_kg") @db.Decimal(12, 3)
  looseWeightKg Decimal? @map("loose_weight_kg") @db.Decimal(12, 3)
  totalWeightKg Decimal? @map("total_weight_kg") @db.Decimal(12, 3)

  @@index([brandId])
  @@index([chemicalId])
  @@map("extruder_details")
}

model LoomDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  yarnInputKg Decimal @map("yarn_input_kg") @db.Decimal(12, 3)

  fabricOutputKg Decimal @map("fabric_output_kg") @db.Decimal(12, 3)

  @@map("loom_details")
}

model FabricCheckDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  fabricInputKg      Decimal          @map("fabric_input_kg") @db.Decimal(12, 3)

  outputKg Decimal? @map("output_kg") @db.Decimal(12, 3)

  @@map("fabric_check_details")
}

enum KoraEntryType {
  CREDIT
  DEBIT
}

model KoraBalance {
  id        String   @id @default(uuid()) @db.Uuid
  colorId   String   @map("color_id") @db.Uuid
  color     Color    @relation(fields: [colorId], references: [id])
  sizeId    String   @map("size_id") @db.Uuid
  size      Size     @relation(fields: [sizeId], references: [id])
  balanceKg Decimal  @default(0) @map("balance_kg") @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries KoraLedgerEntry[]

  @@unique([colorId, sizeId])
  @@map("kora_balances")
}

model KoraLedgerEntry {
  id            String      @id @default(uuid()) @db.Uuid
  koraBalanceId String      @map("kora_balance_id") @db.Uuid
  koraBalance   KoraBalance @relation(fields: [koraBalanceId], references: [id])

  entryType KoraEntryType @map("entry_type")
  stockDate DateTime      @map("stock_date") @db.Date

  productionRecordId String?           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId], references: [id])

  quantityKg     Decimal @map("quantity_kg") @db.Decimal(12, 3)
  balanceAfterKg Decimal @map("balance_after_kg") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)

  @@index([koraBalanceId, createdAt])
  @@map("kora_ledger_entries")
}

model WastageType {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stage ProductionStage

  code String @db.VarChar(50)

  name String @db.VarChar(100)

  isColorTracked Boolean @default(false) @map("is_color_tracked")

  isActive Boolean @default(true) @map("is_active")

  wastageRecords WastageRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, stage, code])
  @@index([companyId, stage, isActive])
  @@map("wastage_types")
}

model WastageRecord {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productionRecordId String @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id])

  wastageTypeId String @map("wastage_type_id") @db.Uuid

  wastageType WastageType @relation(fields: [wastageTypeId], references: [id])

  colorId String? @map("color_id") @db.Uuid

  color Color? @relation(fields: [colorId], references: [id])

  quantityKg Decimal @map("quantity_kg") @db.Decimal(12, 3)

  reason String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([productionRecordId])
  @@index([wastageTypeId])
  @@index([colorId])
  @@map("wastage_records")
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  type InventoryType

  DC_NUMBER String

  name String @db.VarChar(150)

  weightKg Decimal @map("weight_kg") @db.Decimal(12, 3)

  brandId String? @map("brand_id") @db.Uuid

  brand Brand? @relation(fields: [brandId], references: [id])

  chemicalId String? @map("chemical_id") @db.Uuid

  chemical Chemical? @relation(fields: [chemicalId], references: [id])

  colorId String? @map("color_id") @db.Uuid

  color Color? @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, type, brandId])
  @@unique([companyId, type, chemicalId])
  @@unique([companyId, type, colorId])
  @@index([companyId])
  @@index([date])
  @@index([type])
  @@index([name])
  @@map("inventory")
}

model LoadSent {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productionRecordId String?           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  colorId            String  @map("color_id") @db.Uuid
  color              Color   @relation(fields: [colorId], references: [id])
  sizeId             String  @map("size_id") @db.Uuid
  size               Size    @relation(fields: [sizeId], references: [id])
  fabricWeight       Decimal @default(0) @map("fabric_weight") @db.Decimal(12, 3)
  fwWeight           Decimal @default(0) @map("fw_weight") @db.Decimal(12, 3)
  bwWeight           Decimal @default(0) @map("bw_weight") @db.Decimal(12, 3)
  totalWastageWeight Decimal @default(0) @map("total_wastage_weight") @db.Decimal(12, 3)

  driverName String? @map("driver_name") @db.VarChar(100)
  vehicleNo  String? @map("vehicle_no") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([colorId])
  @@index([sizeId])
  @@index([productionRecordId])
  @@map("load_sent")
}
