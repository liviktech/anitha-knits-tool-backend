generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  extruderRawProducts ExtruderRawProduct[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("brands")
}

model Color {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(50)

  extruderProcesses ExtruderProcess[]
  loomProductions   LoomProduction[]
  fabricCheckings   FabricChecking[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("colors")
}

model Chemical {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  extruderChemicals ExtruderChemical[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("chemicals")
}

model Size {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(30)

  extruderProcesses ExtruderProcess[]
  loomProductions   LoomProduction[]
  fabricCheckings   FabricChecking[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("sizes")
}

model ExtruderProcess {
  id String @id @default(uuid()) @db.Uuid

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid
  color   Color  @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid
  size   Size   @relation(fields: [sizeId], references: [id])

  colorWeightKg Decimal @map("color_weight_kg") @db.Decimal(12, 3)

  totalWeightKg Decimal @map("total_weight_kg") @db.Decimal(12, 3)

  loomsWeightKg Decimal @map("looms_weight_kg") @db.Decimal(12, 3)

  rawProduct ExtruderRawProduct?
  chemical   ExtruderChemical?
  waste      ExtruderWaste?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([productionDate])
  @@index([sizeId, colorId])
  @@map("extruder_process")
}

model ExtruderRawProduct {
  id String @id @default(uuid()) @db.Uuid

  extruderProcessId String @unique @map("extruder_process_id") @db.Uuid

  extruderProcess ExtruderProcess @relation(fields: [extruderProcessId], references: [id], onDelete: Cascade)

  brandId String @map("brand_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id])

  bagCount Int @map("bag_count")

  weightKg Decimal @map("weight_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([brandId])
  @@map("extruder_raw_product")
}

model ExtruderChemical {
  id String @id @default(uuid()) @db.Uuid

  extruderProcessId String @unique @map("extruder_process_id") @db.Uuid

  extruderProcess ExtruderProcess @relation(fields: [extruderProcessId], references: [id], onDelete: Cascade)

  chemicalId String @map("chemical_id") @db.Uuid

  chemical Chemical @relation(fields: [chemicalId], references: [id])

  weightKg Decimal @map("weight_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([chemicalId])
  @@map("extruder_chemical")
}

model ExtruderWaste {
  id String @id @default(uuid()) @db.Uuid

  extruderProcessId String @unique @map("extruder_process_id") @db.Uuid

  extruderProcess ExtruderProcess @relation(fields: [extruderProcessId], references: [id], onDelete: Cascade)

  looseWasteKg Decimal @map("loose_waste_kg") @db.Decimal(12, 3)

  lumsWasteKg Decimal @map("lums_waste_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("extruder_waste")
}

model LoomProduction {
  id String @id @default(uuid()) @db.Uuid

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid

  size Size @relation(fields: [sizeId], references: [id])

  loomsWeightKg Decimal @map("looms_weight_kg") @db.Decimal(12, 3)

  fabricWeightKg Decimal @map("fabric_weight_kg") @db.Decimal(12, 3)

  waste LoomWaste?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([productionDate])
  @@index([sizeId, colorId])
  @@map("loom_production")
}

model LoomWaste {
  id String @id @default(uuid()) @db.Uuid

  loomProductionId String @unique @map("loom_production_id") @db.Uuid

  loomProduction LoomProduction @relation(fields: [loomProductionId], references: [id], onDelete: Cascade)

  wasteWeightKg Decimal @map("waste_weight_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("loom_waste")
}

model FabricChecking {
  id String @id @default(uuid()) @db.Uuid

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid

  size Size @relation(fields: [sizeId], references: [id])

  fabricWeightKg Decimal @map("fabric_weight_kg") @db.Decimal(12, 3)

  fiveMeterFabricWeightKg Decimal @map("five_meter_fabric_weight_kg") @db.Decimal(12, 3)

  wastage FabricWastage?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([productionDate])
  @@index([sizeId, colorId])
  @@map("fabric_checking")
}

model FabricWastage {
  id String @id @default(uuid()) @db.Uuid

  fabricCheckingId String @unique @map("fabric_checking_id") @db.Uuid

  fabricChecking FabricChecking @relation(fields: [fabricCheckingId], references: [id], onDelete: Cascade)

  fwWastageKg Decimal @map("fw_wastage_kg") @db.Decimal(12, 3)

  bitWastageKg Decimal @map("bit_wastage_kg") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@map("fabric_wastage")
}
