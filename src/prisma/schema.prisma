generator client {
  provider = "prisma-client-js"

  binaryTargets = ["native", "rhel-openssl-3.0.x"]

  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN

  MANAGER

  SUPERVISOR

  EMPLOYEE
}

enum PlatformAdminRole {
  SUPER_ADMIN
}

enum ProductionStage {
  EXTRUDER

  LOOMS

  FABRIC_CHECKING

  DELIVERY
}

enum ProductionRecordType {
  NORMAL

  ADJUSTMENT

  REVERSAL
}

enum ProductionType {
  PRODUCTION
  SAMPLE
}

enum InventoryType {
  HDPE

  CHEMICAL

  COLOR
}

enum Gender {
  MALE

  FEMALE

  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  COMPANY_HOLIDAY
}

model PlatformAdmin {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  mobile String @unique @db.VarChar(15)

  passwordHash String @map("password_hash") @db.VarChar(255)

  role PlatformAdminRole @default(SUPER_ADMIN)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

model Company {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  address String? @db.VarChar(500)

  gst String? @unique @db.VarChar(20)

  adminMobile String @unique @map("admin_mobile") @db.VarChar(15)

  adminPasswordHash String @map("admin_password_hash") @db.VarChar(255)

  companyCode String @unique @map("company_code") @db.VarChar(50)

  // Next sequence number to assign as a user's customUserId suffix (companyCode + zero-padded seq).
  // Atomically incremented, never decremented — a stable counter, not a row count, so it can't
  // reissue a number after a user/employeeDetails row is later deleted.
  employeeSeq Int @default(1) @map("employee_seq")

  // Next sequence number to assign as a lookup item's itemCode suffix (prefix + zero-padded seq,
  // e.g. "CR" + "001"). Same atomic-counter-never-reissued rule as employeeSeq, one per lookup type.
  colorSeq    Int @default(1) @map("color_seq")
  sizeSeq     Int @default(1) @map("size_seq")
  chemicalSeq Int @default(1) @map("chemical_seq")
  brandSeq    Int @default(1) @map("brand_seq")

  isActive Boolean @default(true) @map("is_active")

  users User[]

  brands Brand[]

  chemicals Chemical[]

  colors Color[]

  sizes Size[]

  colorConsumptionStandards ColorConsumptionStandard[]

  wastageTypes WastageType[]

  productionRecords ProductionRecord[]

  wastageRecords WastageRecord[]

  koraBalances KoraBalance[]

  inventories Inventory[]

  loadSents LoadSent[]

  expenses                 Expense[]
  attendances              Attendance[]
  marketValueDistributions MarketValueDistribution[]
  salaryAdvances           SalaryAdvance[]

  modules      Module[]
  tabs         Tab[]
  rights       Right[]
  roleAccesses RoleAccess[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  payrollRecords PayrollRecord[]

  @@index([name])
  @@index([isActive])
  @@map("companies")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String? @db.VarChar(150)

  mobile String @db.VarChar(15)

  passwordHash String @map("password_hash") @db.VarChar(255)

  role UserRole @default(EMPLOYEE)

  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  employeeDetails EmployeeDetails?

  attendances            Attendance[]
  marketValueAllocations MarketValueAllocation[]
  salaryAdvances         SalaryAdvance[]

  roleAccessId String? @map("role_access_id") @db.Uuid

  roleAccess RoleAccess? @relation(fields: [roleAccessId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy      String?         @map("updated_by") @db.VarChar(100)
  payrollRecords PayrollRecord[]

  @@unique([companyId, mobile])
  @@index([companyId])
  @@index([companyId, role])
  @@index([companyId, isActive])
  @@index([roleAccessId])
  @@map("users")
}

model EmployeeDetails {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Server-generated only (companyCode + zero-padded sequence, e.g. "AK001" + "001") — never accepted from a client.
  customUserId String @unique @map("custom_user_id") @db.VarChar(60)

  name String? @db.VarChar(150)

  designation String? @db.VarChar(100)

  address String? @db.VarChar(500)

  gender Gender?

  salary Decimal? @db.Decimal(12, 2)

  photoUrl String? @map("photo_url") @db.VarChar(500)

  aadhaarNumber String? @map("aadhaar_number") @db.VarChar(20)

  aadhaarDocumentUrl String? @map("aadhaar_document_url") @db.VarChar(500)

  documentName String? @map("document_name") @db.VarChar(255)

  aadhaarDocumentUploadedAt DateTime? @map("aadhaar_document_uploaded_at") @db.Timestamptz(6)

  joiningDate DateTime? @map("joining_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("employee_details")
}

model Attendance {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String @map("employee_id") @db.Uuid
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?          @db.VarChar(500)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?          @map("created_by") @db.VarChar(100)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?          @map("updated_by") @db.VarChar(100)

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("attendances")
}

model Brand {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Server-generated only (never accepted from a client): "BD" + zero-padded per-company sequence (Company.brandSeq).
  itemCode String @map("item_code") @db.VarChar(20)

  name String @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  inventories Inventory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("brands")
}

model Chemical {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Server-generated only (never accepted from a client): "CL" + zero-padded per-company sequence (Company.chemicalSeq).
  itemCode String @map("item_code") @db.VarChar(20)

  name String @db.VarChar(100)

  extruderDetails ExtruderDetail[]

  inventories Inventory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("chemicals")
}

model Color {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Server-generated only (never accepted from a client): "CR" + zero-padded per-company sequence (Company.colorSeq).
  itemCode String @map("item_code") @db.VarChar(20)

  name String @db.VarChar(50)

  productionRecords ProductionRecord[]

  wastageRecords WastageRecord[]

  loadSents LoadSent[]

  inventories Inventory[]

  koraBalances KoraBalance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("colors")
}

model Size {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Server-generated only (never accepted from a client): "SE" + zero-padded per-company sequence (Company.sizeSeq).
  itemCode String @map("item_code") @db.VarChar(20)

  name String @db.VarChar(30)

  productionRecords ProductionRecord[]

  koraBalances KoraBalance[]

  loadSents LoadSent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, name])
  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("sizes")
}

model ColorConsumptionStandard {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  basisWeightKg Decimal @default(25) @map("basis_weight_kg") @db.Decimal(10, 3)

  hdpematerialbag Int @default(1) @map("hdpe_material_bag")

  whiteKgBasis Decimal @map("white_kg_basis") @db.Decimal(10, 3)
  blueKgBasis  Decimal @map("blue_kg_basis") @db.Decimal(10, 3)
  greenKgBasis Decimal @map("green_kg_basis") @db.Decimal(10, 3)

  chemicalWeight Decimal?  @map("chemical_weight_kg") @db.Decimal(12, 3)
  date           DateTime? @map("date") @db.Date

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@map("color_consumption_standards")
}

model ProductionRecord {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type ProductionType @default(PRODUCTION)

  stage ProductionStage

  productionDate DateTime @map("production_date") @db.Date

  colorId String @map("color_id") @db.Uuid

  color Color @relation(fields: [colorId], references: [id])

  sizeId String @map("size_id") @db.Uuid

  size Size @relation(fields: [sizeId], references: [id])

  recordType ProductionRecordType @default(NORMAL) @map("record_type")

  reversesRecordId String? @map("reverses_record_id") @db.Uuid

  reversesRecord ProductionRecord? @relation("ProductionCorrection", fields: [reversesRecordId], references: [id])

  corrections ProductionRecord[] @relation("ProductionCorrection")

  remarks String? @db.VarChar(500)

  isApproved Boolean @default(false) @map("is_approved")

  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  approvedBy String? @map("approved_by") @db.VarChar(100)

  extruder ExtruderDetail?

  loom LoomDetail?

  fabricCheck FabricCheckDetail?
  wastages    WastageRecord[]
  loadSent    LoadSent?
  koraEntries KoraLedgerEntry?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([companyId, productionDate])
  @@index([companyId, stage, productionDate])
  @@index([companyId, isApproved])
  @@index([colorId, sizeId])
  @@index([reversesRecordId])
  @@map("production_records")
}

model ExtruderDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  brandId String @map("brand_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id])

  rawMaterialKg Decimal @map("raw_material_kg") @db.Decimal(12, 3)

  chemicalId String @map("chemical_id") @db.Uuid

  chemical Chemical @relation(fields: [chemicalId], references: [id])

  chemicalKg Decimal @map("chemical_kg") @db.Decimal(12, 3)

  colorConsumedKg Decimal @map("color_consumed_kg") @db.Decimal(12, 3)

  yarnOutputKg Decimal @map("yarn_output_kg") @db.Decimal(12, 3)

  isRecipeOverridden Boolean @default(false) @map("is_recipe_overridden")

  overrideReason String? @map("override_reason") @db.VarChar(500)

  bagCount      Int?     @map("bag_count")
  bagWeightKg   Decimal? @map("bag_weight_kg") @db.Decimal(12, 3)
  looseWeightKg Decimal? @map("loose_weight_kg") @db.Decimal(12, 3)
  totalWeightKg Decimal? @map("total_weight_kg") @db.Decimal(12, 3)

  @@index([brandId])
  @@index([chemicalId])
  @@map("extruder_details")
}

model LoomDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String @unique @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  yarnInputKg Decimal @map("yarn_input_kg") @db.Decimal(12, 3)

  fabricOutputKg Decimal @map("fabric_output_kg") @db.Decimal(12, 3)

  @@map("loom_details")
}

model FabricCheckDetail {
  id String @id @default(uuid()) @db.Uuid

  productionRecordId String           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  fabricInputKg      Decimal          @map("fabric_input_kg") @db.Decimal(12, 3)

  outputKg Decimal? @map("output_kg") @db.Decimal(12, 3)

  @@map("fabric_check_details")
}

enum KoraEntryType {
  CREDIT
  DEBIT
}

enum RightAction {
  VIEW
  ADD
  EDIT
  DELETE
}

model KoraBalance {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?   @map("company_id") @db.Uuid
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  colorId   String   @map("color_id") @db.Uuid
  color     Color    @relation(fields: [colorId], references: [id])
  sizeId    String   @map("size_id") @db.Uuid
  size      Size     @relation(fields: [sizeId], references: [id])
  balanceKg Decimal  @default(0) @map("balance_kg") @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries KoraLedgerEntry[]

  @@unique([colorId, sizeId])
  @@index([companyId])
  @@map("kora_balances")
}

model KoraLedgerEntry {
  id            String      @id @default(uuid()) @db.Uuid
  koraBalanceId String      @map("kora_balance_id") @db.Uuid
  koraBalance   KoraBalance @relation(fields: [koraBalanceId], references: [id])

  entryType KoraEntryType @map("entry_type")
  stockDate DateTime      @map("stock_date") @db.Date

  productionRecordId String?           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId], references: [id])

  quantityKg     Decimal @map("quantity_kg") @db.Decimal(12, 3)
  balanceAfterKg Decimal @map("balance_after_kg") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)

  @@index([koraBalanceId, createdAt])
  @@map("kora_ledger_entries")
}

model WastageType {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stage ProductionStage

  code String @db.VarChar(50)

  name String @db.VarChar(100)

  isColorTracked Boolean @default(false) @map("is_color_tracked")

  isActive Boolean @default(true) @map("is_active")

  wastageRecords WastageRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, stage, code])
  @@index([companyId, stage, isActive])
  @@map("wastage_types")
}

model WastageRecord {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productionRecordId String @map("production_record_id") @db.Uuid

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id])

  wastageTypeId String @map("wastage_type_id") @db.Uuid

  wastageType WastageType @relation(fields: [wastageTypeId], references: [id])

  colorId String? @map("color_id") @db.Uuid

  color Color? @relation(fields: [colorId], references: [id])

  quantityKg Decimal @map("quantity_kg") @db.Decimal(12, 3)

  reason String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([productionRecordId])
  @@index([wastageTypeId])
  @@index([colorId])
  @@map("wastage_records")
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  type InventoryType

  DC_NUMBER String

  name String @db.VarChar(150)

  weightKg Decimal @map("weight_kg") @db.Decimal(12, 3)

  bagCount Int? @map("bag_count")

  brandId String? @map("brand_id") @db.Uuid

  brand Brand? @relation(fields: [brandId], references: [id])

  chemicalId String? @map("chemical_id") @db.Uuid

  chemical Chemical? @relation(fields: [chemicalId], references: [id])

  colorId String? @map("color_id") @db.Uuid

  color Color? @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, type, brandId])
  @@unique([companyId, type, chemicalId])
  @@unique([companyId, type, colorId])
  @@index([companyId])
  @@index([date])
  @@index([type])
  @@index([name])
  @@map("inventory")
}

model LoadSent {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productionRecordId String?           @unique @map("production_record_id") @db.Uuid
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  colorId            String  @map("color_id") @db.Uuid
  color              Color   @relation(fields: [colorId], references: [id])
  sizeId             String  @map("size_id") @db.Uuid
  size               Size    @relation(fields: [sizeId], references: [id])
  fabricWeight       Decimal @default(0) @map("fabric_weight") @db.Decimal(12, 3)
  fwWeight           Decimal @default(0) @map("fw_weight") @db.Decimal(12, 3)
  bwWeight           Decimal @default(0) @map("bw_weight") @db.Decimal(12, 3)
  totalWastageWeight Decimal @default(0) @map("total_wastage_weight") @db.Decimal(12, 3)

  driverName String? @map("driver_name") @db.VarChar(100)
  vehicleNo  String? @map("vehicle_no") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@index([companyId])
  @@index([colorId])
  @@index([sizeId])
  @@index([productionRecordId])
  @@map("load_sent")
}

model Expense {
  id String @id @default(uuid()) @db.Uuid

  expenseId String @map("expense_id") @db.VarChar(20)

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  date DateTime @default(now()) @db.Date

  expenseName String @map("expense_name") @db.VarChar(150)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy String? @map("updated_by") @db.VarChar(100)

  @@unique([companyId, expenseId])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, expenseName])
  @@map("expenses")
}

model Module {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  moduleCode String @map("module_code") @db.VarChar(50)

  moduleName String @map("module_name") @db.VarChar(100)

  tabs Tab[]

  rights Right[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, moduleCode])
  @@index([companyId])
  @@map("modules")
}

model Tab {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  moduleId String @map("module_id") @db.Uuid

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  tabCode String @map("tab_code") @db.VarChar(50)

  tabName String @map("tab_name") @db.VarChar(100)

  rights Right[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, moduleId, tabCode])
  @@index([companyId])
  @@index([moduleId])
  @@map("tabs")
}

model Right {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  moduleId String @map("module_id") @db.Uuid

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Optional: a right can be scoped to one specific Tab within its Module, or left null to
  // grant the whole module (most modules today have no Tabs at all — e.g. Production Details).
  tabId String? @map("tab_id") @db.Uuid

  tab Tab? @relation(fields: [tabId], references: [id], onDelete: Cascade)

  // What the right grants on this Module (+ optional Tab) — the admin picks Module > Tab >
  // Action; rightName/displayName below are derived from these, never typed by the admin.
  action RightAction

  // Server-derived stable identifier, e.g. "productiondetails_all_edit" — this (not a raw
  // moduleId+tabId+action tuple) is what @@unique enforces, since Postgres doesn't treat two
  // NULL tabId rows as equal, so a composite unique including tabId can't reliably prevent
  // duplicate "same module/tab/action" rights on its own.
  rightName String @map("right_name") @db.VarChar(150)

  // Server-derived human label, e.g. "Production Details – Edit".
  displayName String @map("display_name") @db.VarChar(200)

  roleLinks RoleAccessRight[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, rightName])
  @@index([companyId])
  @@index([moduleId])
  @@index([tabId])
  @@map("rights")
}

model RoleAccess {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roleName String @map("role_name") @db.VarChar(100)

  description String? @db.VarChar(500)

  rights RoleAccessRight[]

  users User[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, roleName])
  @@index([companyId])
  @@map("role_access")
}

model RoleAccessRight {
  id String @id @default(uuid()) @db.Uuid

  roleAccessId String @map("role_access_id") @db.Uuid

  roleAccess RoleAccess @relation(fields: [roleAccessId], references: [id], onDelete: Cascade)

  rightId String @map("right_id") @db.Uuid

  right Right @relation(fields: [rightId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([roleAccessId, rightId])
  @@index([rightId])
  @@map("role_access_rights")
}

model MarketValueDistribution {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  effectiveDate DateTime @map("effective_date") @db.Date
  totalPool     Decimal  @map("total_pool") @db.Decimal(12, 2)

  allocations MarketValueAllocation[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([companyId, effectiveDate])
  @@map("market_value_distributions")
}

model MarketValueAllocation {
  id String @id @default(uuid()) @db.Uuid

  distributionId String                  @map("distribution_id") @db.Uuid
  distribution   MarketValueDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  employeeId String @map("employee_id") @db.Uuid
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([distributionId])
  @@index([employeeId])
  @@map("market_value_allocations")
}

model SalaryAdvance {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String @map("employee_id") @db.Uuid
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount        Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @map("effective_date") @db.Date

  repaymentMethod String @map("repayment_method") @db.VarChar(50)

  // EMI-only: null for a single (one-shot) advance. totalMonths is how many
  // consecutive payroll months the amount is spread across; emiAmount is the
  // per-month deduction (amount / totalMonths, rounded at creation time so
  // every month deducts a fixed, predictable figure instead of re-deriving it).
  totalMonths Int?     @map("total_months")
  emiAmount   Decimal? @map("emi_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([companyId, effectiveDate])
  @@index([employeeId])
  @@map("salary_advances")
}

model PayrollRecord {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String @map("employee_id") @db.Uuid
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month Int @db.SmallInt
  year  Int @db.SmallInt

  baseSalary       Decimal @map("base_salary") @db.Decimal(12, 2)
  totalDaysInMonth Int     @map("total_days_in_month") @db.SmallInt
  daysWorked       Decimal @map("days_worked") @db.Decimal(5, 2)

  lopDeduction     Decimal @map("lop_deduction") @db.Decimal(12, 2)
  advanceDeduction Decimal @map("advance_deduction") @db.Decimal(12, 2)
  sundayBonuses    Decimal @map("sunday_bonuses") @db.Decimal(12, 2)
  marketValueBonus Decimal @map("market_value_bonus") @db.Decimal(12, 2)

  grossSalary Decimal @map("gross_salary") @db.Decimal(12, 2)
  netSalary   Decimal @map("net_salary") @db.Decimal(12, 2)

  status String @default("PENDING") @db.VarChar(50) // PENDING, PAID, etc.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, month, year])
  @@index([companyId, month, year])
  @@map("payroll_records")
}
