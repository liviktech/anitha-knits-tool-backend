NODE_ENV=development
PORT=4000
# Comma-separated allowlist, enforced only when NODE_ENV=production, e.g.
# CORS_ORIGINS=https://anitha-knits-tool-frontend.vercel.app
CORS_ORIGINS=
DATABASE_URL=postgres://user:password@localhost:5432/anitha_backend
# Pool sizing (all optional, defaults shown). Set DB_POOL_MAX=1 when running behind RDS Proxy on Lambda.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Auth (JWT) - generate distinct random 32+ char secrets per environment, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-random-32+-char-secret
JWT_EXPIRES_IN=15m
JWT_COOKIE_NAME=access_token
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=refresh_token
BCRYPT_SALT_ROUNDS=10

# Auth (Platform Admin JWT) - separate secrets from the company-user tokens above
PLATFORM_ADMIN_JWT_SECRET=replace-with-a-random-32+-char-secret
PLATFORM_ADMIN_JWT_EXPIRES_IN=15m
PLATFORM_ADMIN_ACCESS_COOKIE_NAME=platform_admin_access_token
PLATFORM_ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret
PLATFORM_ADMIN_JWT_REFRESH_EXPIRES_IN=7d
PLATFORM_ADMIN_REFRESH_COOKIE_NAME=platform_admin_refresh_token

SEED_COMPANY_ID=

# AWS S3 (employee photo / Aadhaar document uploads) - bucket must have a
# public-read bucket policy for s3:GetObject; do not rely on object ACLs.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-iam-secret-access-key
AWS_S3_BUCKET_NAME=replace-with-your-bucket-name

# AWS Pinpoint (SMS OTP) - reuses AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# above; the IAM identity needs mobiletargeting:SendMessages. Create a Pinpoint
# project (Application), enable the SMS channel, register an origination
# identity, and create two SMS templates (Name = the values below) each
# containing {{OTPCode}} and {{TTLMinutes}} placeholders.
PINPOINT_APPLICATION_ID=replace-with-your-pinpoint-project-id
PINPOINT_SMS_TEMPLATE_LOGIN=otp-login
PINPOINT_SMS_TEMPLATE_RESET=otp-reset-password
# Optional - a dedicated long/short code in E.164 format; if unset, Pinpoint
# assigns a random long code per message.
PINPOINT_ORIGINATION_NUMBER=
OTP_LENGTH=6
OTP_TTL_MINUTES=2
OTP_MAX_ATTEMPTS=5
# Auth (Reset token) - generate a distinct random 32+ char secret, e.g. `openssl rand -hex 32`
RESET_TOKEN_SECRET=replace-with-a-different-random-32+-char-secret
