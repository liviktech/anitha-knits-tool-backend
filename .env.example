NODE_ENV=development
PORT=4000
CORS_ORIGINS=
DATABASE_URL=postgres://user:password@localhost:5432/anitha_backend

# Auth (JWT) - generate distinct random 32+ char secrets per environment, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-random-32+-char-secret
JWT_EXPIRES_IN=15m
JWT_COOKIE_NAME=access_token
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=refresh_token
BCRYPT_SALT_ROUNDS=10
